{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "dialog:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "https://*:*/*" },
        { "url": "http://*/*" },
        { "url": "http://*:*/*" }
      ]
    },
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$DOCUMENT/Lorewright" },
        { "path": "$DOCUMENT/Lorewright/**" },
        { "path": "$DOCUMENT/Marginalia" },
        { "path": "$DOCUMENT/Marginalia/**" }
      ]
    }
  ]
}
